# Copy this file to .env, then replace every REPLACE_WITH_... value.
# Keep the real .env file local; it is ignored by git.
DATABASE_URL=jdbc:postgresql://localhost:5432/nexushr
DATABASE_USERNAME=REPLACE_WITH_DATABASE_USERNAME
DATABASE_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
FRONTEND_ORIGIN=http://localhost:5173
SERVER_PORT=8090
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
SWAGGER_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_POLL_INTERVAL_MS=30000
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
ATTENDANCE_TIME_ZONE=Asia/Kolkata
ATTENDANCE_WORKDAY_START=09:00
ATTENDANCE_GRACE_MINUTES=0
GRAFANA_ADMIN_USER=REPLACE_WITH_GRAFANA_ADMIN_USER
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD
